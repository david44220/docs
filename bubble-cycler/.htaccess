# Used when the web server's document root is this folder (typical shared
# hosting). Everything is routed into public/ and the application folders stay
# private. If you can, point the document root at public/ instead.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|database|storage|tests)(/.*)?$ - [F,L]
    RewriteRule ^(\.git|\.env|README\.md) - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
