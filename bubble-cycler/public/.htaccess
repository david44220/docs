Options -Indexes
DirectoryIndex index.php

# Compress text responses.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/csv application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# CSS, JS, images and fonts are linked with ?v=<file time> (see asset()), so
# browsers may keep them for a year; a changed file gets a new URL.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
</IfModule>

# Hidden files (.htaccess, .git …) are never served.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
